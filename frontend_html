@app.route("/api/complaints", methods=["GET", "POST"])
def api_complaints():
    if request.method == "POST":
        title = request.form.get("title", "").strip()
        description = request.form.get("description", "").strip()
        category = request.form.get("category", "Infrastructure")
        location = request.form.get("location", "").strip()
        severity = request.form.get("severity", "medium").lower()
        org_id = request.form.get("organization_id", "reva-uni")
        
        org = next((o for o in ORGANIZATIONS if o["id"] == org_id), ORGANIZATIONS[0])
        
        image_url = ""
        file = request.files.get("image")
        if file and file.filename:
            fname = secure_filename(file.filename)
            unique_name = f"{int(time.time())}_{fname}"
            fpath = os.path.join(app.config["UPLOAD_FOLDER"], unique_name)
            file.save(fpath)
            image_url = f"/static/uploads/{unique_name}"
            
        new_id = f"CMP-{len(COMPLAINTS) + 105}"
        now = datetime.now(timezone.utc).isoformat()
        
        new_complaint = {
            "id": new_id,
            "title": title or "Reported Complaint",
            "description": description,
            "category": category,
            "organization": org["name"],
            "organization_id": org["id"],
            "location": location or org.get("locations", ["Main Campus"])[0],
            "priority": severity,
            "status": "Submitted",
            "created_at": now,
            "updated_at": now,
            "image_url": image_url,
            "history": [
                {"status": "Submitted", "at": now},
                {"status": "Under AI Analysis", "at": now}
            ],
            "updates": [],
            "feedback_submitted": False
        }
        
        COMPLAINTS.insert(0, new_complaint)
        
        # Add a notification
        NOTIFICATIONS.insert(0, {
            "id": f"n{len(NOTIFICATIONS) + 1}",
            "message": f"Complaint #{new_id} was successfully submitted and queued for AI analysis.",
            "created_at": now,
            "read": False,
            "link": f"/complaints/{new_id}"
        })
        
        return jsonify({"id": new_id, "message": "Complaint submitted successfully"}), 201

    # GET complaints
    q = request.args.get("q", "").strip().lower()
    status = request.args.get("status", "").strip()
    priority = request.args.get("priority", "").strip().lower()
    category = request.args.get("category", "").strip()
    
    items = COMPLAINTS
    if q:
        items = [c for c in items if q in c["title"].lower() or q in c["id"].lower() or q in c["description"].lower()]
    if status:
        items = [c for c in items if c["status"].lower() == status.lower()]
    if priority:
        items = [c for c in items if c["priority"].lower() == priority]
    if category:
        items = [c for c in items if c["category"].lower() == category.lower()]
        
    return jsonify({"items": items})


