    user = session.get("user")
    if not user:
        # Default user with Staff/Admin role so all pages (Citizen + Staff portal) work seamlessly
        user = {"name": "Alex Morgan", "role": "admin", "is_authenticated": True}
    
    class CurrentUser:
        name = user.get("name", "Alex Morgan")
        role = user.get("role", "admin")
        is_authenticated = bool(user.get("is_authenticated", True))

    return {"current_user": CurrentUser()}


